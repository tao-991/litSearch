# Copy this file to .env and fill in what you have. Leave a value empty to skip it.
# Search works without any key; the model-based steps (Phase 1e onward) need the
# LLM settings below. Check them with: uv run litsearch check-llm

# Optional. Used in the User-Agent header and as the OpenAlex "mailto" parameter (identifier only).
CONTACT_EMAIL=

# Recommended. Free OpenAlex key (openalex.org/settings/api); raises the daily quota about tenfold.
OPENALEX_API_KEY=

# Optional. Semantic Scholar API key; unauthenticated requests are used when empty.
S2_API_KEY=

# Key of the model API, or of the API relay you use.
LLM_API_KEY=

# Optional. Base URL of an API relay, for example https://your-relay.example.com or
# https://your-relay.example.com/v1 (both work). Empty = the official API.
# Must start with http:// or https://.
LLM_BASE_URL=

# Optional. How to talk to the models: auto (default), anthropic or openai.
# auto: model names starting with "claude" use the Anthropic message format, all other
# names (gpt-*, gemini-*, deepseek-*, ...) use the OpenAI chat format. One key and one base
# URL can serve both, which is how most relays work.
LLM_API_FORMAT=

# Older names for LLM_API_KEY and LLM_BASE_URL; they still work when the LLM_* ones are empty.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Model names, exactly as your API or relay offers them (they may differ from the official ones).
# L1_MODEL: cheap model that scores papers from title and abstract. Use a model WITHOUT
#   long hidden reasoning (for example gpt-4.1-nano or gpt-4o-mini); reasoning models are
#   slow here and often get cut off.
# QUERY_MODEL: stronger model that writes the search queries.
L1_MODEL=
QUERY_MODEL=

# Language of what the model writes for you to read: the project brief, and later the
# summaries and relevance reasons. Search queries are always English. Empty = Chinese.
SUMMARY_LANGUAGE=

# Optional. Where the SQLite working cache is stored (default ./data).
DATA_DIR=

# Optional. Proxy for the HTTPS requests to the data sources, for example http://127.0.0.1:7890
HTTPS_PROXY=

# Optional. Google Scholar (a later phase) waits a random time in this range between requests, in seconds.
# Empty = 10 and 30.
GS_MIN_DELAY=
GS_MAX_DELAY=
